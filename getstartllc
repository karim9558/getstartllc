           TRUST BAR
        ================================= */

        .trust {

            background: white;

            padding: 25px;

            box-shadow: 0 5px 30px rgba(0,0,0,0.08);

            position: relative;

            z-index: 5;

        }


        .trust-container {

            max-width: 1100px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;

            text-align: center;

        }


        .trust-item strong {

            display: block;

            color: var(--blue);

            font-size: 18px;

            margin-bottom: 5px;

        }


        .trust-item span {

            font-size: 12px;

            color: var(--gray);

        }


