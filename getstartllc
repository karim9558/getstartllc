            font-size: 25px;

            font-weight: 800;

            color: var(--blue);

        }

        .logo span {

            color: var(--red);

        }


        /* NAVIGATION */

        .nav-links {

            display: flex;

            gap: 30px;

            list-style: none;

        }

        .nav-links a {

            color: var(--dark);

            font-size: 14px;

            font-weight: 500;

            transition: 0.3s;

        }

        .nav-links a:hover {

            color: var(--red);

        }


        /* HEADER BUTTON */

        .nav-button {

            background: var(--red);

            color: white;

            padding: 12px 20px;

            border-radius: 6px;

            font-size: 13px;

            font-weight: 600;

        }


        /* =================================
           HERO
        ================================= */

        .hero {

            min-height: 100vh;

            padding-top: 90px;

            position: relative;

            display: flex;

            align-items: center;

            overflow: hidden;

            background:

                linear-gradient(
                    90deg,
                    rgba(4,31,60,0.95) 0%,
                    rgba(4,31,60,0.82) 45%,
                    rgba(4,31,60,0.35) 100%
                ),

                url("https://images.unsplash.com/photo-1485871981521-5b1fd3805eee?auto=format&fit=crop&w=2000&q=85");

            background-size: cover;

            background-position: center;

        }


        /* RED / BLUE DECORATION */

        .hero::after {

            content: "";

            position: absolute;

            bottom: 0;

            left: 0;

            width: 100%;

            height: 7px;

            background:

                linear-gradient(
                    to right,
                    var(--red) 50%,
                    var(--white) 50%,
                    var(--white) 75%,
                    var(--blue) 75%
                );

        }


        .hero-content {

            max-width: 1200px;

            width: 100%;

            margin: auto;

            padding: 80px 25px;

            position: relative;

            z-index: 2;

        }


        .hero-label {

            display: inline-block;

            color: white;

            background: rgba(255,255,255,0.12);

            border: 1px solid rgba(255,255,255,0.25);

            padding: 8px 15px;

            border-radius: 30px;

            font-size: 12px;

            font-weight: 600;

            margin-bottom: 25px;

        }


        .hero h1 {

            max-width: 750px;

            font-size: clamp(45px, 6vw, 75px);

            line-height: 1.05;

            color: white;

            margin-bottom: 25px;

        }


        .hero h1 span {

            color: #ff3038;

        }


        .hero p {

            max-width: 650px;

            color: #e5edf6;

            line-height: 1.8;

            font-size: 17px;

            margin-bottom: 35px;

        }


        /* HERO BUTTONS */

        .buttons {

            display: flex;

            gap: 15px;

            flex-wrap: wrap;

        }


        .btn {

            display: inline-block;

            padding: 15px 28px;

            border-radius: 6px;

            font-size: 14px;

            font-weight: 700;

            transition: 0.3s;

        }


        .btn-primary {

            background: var(--red);

            color: white;

        }


        .btn-primary:hover {

            background: #b81218;

            transform: translateY(-2px);

        }


        .btn-secondary {

            background: white;

            color: var(--blue);

        }


        .btn-secondary:hover {

            background: #edf5ff;

        }


