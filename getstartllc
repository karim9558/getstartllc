            background: #061c33;

            color: white;

            padding: 60px 25px 25px;

        }


        .footer-container {

            max-width: 1150px;

            margin: auto;

            display: grid;

            grid-template-columns:
                2fr 1fr 1fr;

            gap: 50px;

